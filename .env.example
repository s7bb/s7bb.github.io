# DB Timetables API credentials
DB_API_KEY=your_key_here
DB_CLIENT_ID=your_client_id_here

# Baierbrunn EVA station number (override only if DB renumbers the station)
S7BB_EVA=8000781

# Scheduler cron expressions (standard 5-field cron). Quote to prevent
# shell glob expansion when sourced via `set -a; . ./.env`.
FETCH_CRON="*/5 * * * *"
EXPORT_CRON="0 * * * *"

# GitHub fine-grained Personal Access Token. Required for the hourly push
# to the s7bb-data repo. Scope: repository = s7bb/s7bb-data only,
# Contents = Read and write (Metadata = Read auto-granted), all other
# permissions = No access. The bot PAT has no access to the code repo.
# See README §5 for the rotation flow.
GITHUB_PAT=github_pat_REPLACE_ME

# Optional: override the owner/repo slug used for the HTTPS push URL.
# Auto-detected from the s7bb-data clone's `origin` (s7bb/s7bb-data) when
# unset. If set, the `repo_identity` preflight HARD-fails on mismatch —
# leave unset unless the auto-provisioned clone uses a non-standard URL.
# GITHUB_REPO_SLUG=s7bb/s7bb-data

# Git identity for automated commits made inside the container
GIT_AUTHOR_NAME=s7bb-bot
GIT_AUTHOR_EMAIL=s7bb-bot@localhost
GIT_COMMITTER_NAME=s7bb-bot
GIT_COMMITTER_EMAIL=s7bb-bot@localhost

# Host UID/GID so the container writes to data/ as the correct owner.
# Renamed from UID/GID because bash treats `UID` as a readonly variable,
# which breaks `set -a; . ./.env`. Find yours with: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# Container-internal paths — defaults match the docker-compose volume mounts
# DATA_DIR=/data
# REPO_PATH=/repo
