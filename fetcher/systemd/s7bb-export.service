[Unit]
Description=S7BB: export data to JSON and push to GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=s7bb
WorkingDirectory=/opt/s7bb
EnvironmentFile=/opt/s7bb/.env
ExecStart=/opt/s7bb/.venv/bin/s7bb-export
ExecStartPost=/opt/s7bb/push-data.sh
StandardOutput=journal
StandardError=journal
